{
  "manifest_version": 3,
  "name": "Vernacue",
  "version": "0.1.1",
  "minimum_chrome_version": "120",
  "description": "Study YouTube subtitles: translate, break down sentences and explain words using your own AI provider.",
  "permissions": ["storage", "scripting", "webRequest"],
  "host_permissions": ["https://www.youtube.com/*"],
  "optional_host_permissions": [
    "https://api.groq.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*"
  ],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Vernacue" },
  "options_page": "options.html",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
